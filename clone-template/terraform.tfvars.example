# Copy to terraform.tfvars and edit.

proxmox_endpoint  = "https://192.168.1.10:8006/"
proxmox_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true

node_name   = "hvir111d"
template_id = 104
datastore   = "iscsi-netapp"

# Template 104's boot disk: scsi0, 50 GB. disk_gb = default size of every VM
# (a VM can set its own disk_gb; never smaller than the template's 50).
disk_interface   = "scsi0"
template_disk_gb = 50
disk_gb          = 50

# Start the VMs once their IP is set.
start_vms = true

# ---------------------------------------------------------------------------
# Network defaults for all VMs. Change them here once; a VM only needs its own
# value when it differs.
# ---------------------------------------------------------------------------
network_bridge = "vmbr1"
network_model  = "vmxnet3" # virtio, vmxnet3, e1000
# vlan_id      = 20
gateway        = "192.168.1.1"
ip_prefix      = 24 # added to IPs written without /prefix

dns_servers = ["192.168.1.1", "8.8.8.8"]
# dns_domain = "example.local"

# ---------------------------------------------------------------------------
# VMs: one line each. ip = "192.168.1.61", "192.168.1.61/24" or "dhcp".
# Spread over several Proxmox nodes with node = "hvir211d" etc. (the template
# is cloned from node_name; its storage must be shared).
# Optional per VM (overrides the defaults above): disk_gb, node, bridge,
# model, vlan_id, gateway, mac_address, firewall, mtu, dns_servers,
# dns_domain, extra_networks.
# ---------------------------------------------------------------------------
vms = [
  { name = "k8s-jumpbox", vm_id = 300, ip = "192.168.1.60" },

  { name = "k8s-master-1", vm_id = 301, ip = "192.168.1.61" },
  { name = "k8s-master-2", vm_id = 302, ip = "192.168.1.62" },
  { name = "k8s-master-3", vm_id = 303, ip = "192.168.1.63" },

  { name = "k8s-worker-1", vm_id = 311, ip = "192.168.1.71", disk_gb = 100 },
  { name = "k8s-worker-2", vm_id = 312, ip = "192.168.1.72", disk_gb = 100 },
  { name = "k8s-worker-3", vm_id = 313, ip = "192.168.1.73", disk_gb = 100 },

  # Examples:
  # { name = "other-net", vm_id = 320, ip = "10.20.0.5", bridge = "vmbr0", vlan_id = 20, gateway = "10.20.0.1" },
  # { name = "two-cards", vm_id = 321, ip = "192.168.1.80",
  #   extra_networks = { net1 = { bridge = "vmbr0", vlan_id = 30, ip = "10.30.0.80/24" } } },
]
